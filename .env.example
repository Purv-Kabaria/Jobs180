SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/company_tracker
SPRING_DATASOURCE_USERNAME=tracker
SPRING_DATASOURCE_PASSWORD=tracker
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

APP_STORAGE_TYPE=s3
APP_S3_ENDPOINT=http://localhost:9000
APP_S3_BUCKET=company-tracker
APP_S3_ACCESS_KEY=minioadmin
APP_S3_SECRET_KEY=minioadmin
APP_S3_REGION=us-east-1
APP_S3_PATH_STYLE=true

APP_UPLOAD_MAX_BYTES=10485760
APP_IDEMPOTENCY_TTL_SECONDS=86400
APP_SIGNUPS_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=
APP_DISPLAY_ZONE=UTC

APP_RATE_LIMIT_LOGIN_PER_MIN=5
APP_RATE_LIMIT_SIGNUP_PER_MIN=3
APP_RATE_LIMIT_WRITE_PER_MIN=60
APP_RATE_LIMIT_UPLOAD_PER_MIN=10
APP_RATE_LIMIT_IP_PER_MIN=120

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
SERVER_PORT=8080
